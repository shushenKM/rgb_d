{
  "depth": {
    "modality": "depth",
    "dataset_config": "configs/dataset.json",
    "model": "mvtn",
    "views": [
      "above"
    ],
    "subject_ids": null,
    "session_ids": [
      "step1",
      "step2",
      "step3"
    ],
    "expected_class_count": 9,
    "expected_gesture_labels": [
      "approach",
      "deinsert",
      "grasp",
      "insert",
      "lift",
      "move",
      "place",
      "release",
      "screw"
    ],
    "input": {
      "num_frames": 8,
      "image_size": 128,
      "depth_min": 0.0,
      "depth_max": 5000.0
    },
    "screw_sampling": {
      "duration_s": 1.0,
      "segments_per_trial": 5,
      "short_parent_policy": "shrink"
    },
    "data_quality": {
      "allow_within_subject_test_overlap": true
    },
    "model_parameters": {
      "pretrained_backbone": null
    },
    "training": {
      "epochs": 20,
      "batch_size": 4,
      "learning_rate": 0.0001,
      "weight_decay": 0.001,
      "seed": 42,
      "device": "cuda",
      "num_workers": 4,
      "cpu_threads": 4,
      "deterministic": true,
      "amp": true,
      "validation": {
        "strategy": "auto",
        "fraction": 0.2,
        "allow_train_validation_overlap": true
      },
      "scheduler": {
        "type": "reduce_on_plateau",
        "factor": 0.5,
        "patience": 3,
        "min_lr": 1e-06
      },
      "early_stopping_patience": 10,
      "gradient_clip_norm": 5.0
    },
    "output_root": "runs/depth"
  },
  "dataset": {
    "dataset_root": "../dataset",
    "read_only": true,
    "annotation_locale": "EN",
    "annotation_file_pattern": "rgb_depth_gesture_segments*_EN.csv",
    "subject_ids": null,
    "folders": {
      "annotations": "annotation",
      "rgbd": "rgbd"
    },
    "session_mapping": {
      "step1": "session1",
      "step2": "session2",
      "step3": "session3"
    }
  },
  "protocol": {
    "name": "protocol2",
    "type": "held_out_repetitions",
    "train_repetitions": [
      1,
      2,
      3,
      4
    ],
    "test_repetitions": [
      5
    ],
    "validation": null,
    "gesture_rules": {
      "screw": {
        "train_repetitions": [
          1,
          2
        ],
        "test_repetitions": [
          3
        ]
      },
      "insert": {
        "train_repetitions": [
          1,
          2,
          3,
          4,
          6,
          7,
          8,
          9
        ],
        "test_repetitions": [
          5,
          10
        ]
      },
      "deinsert": {
        "train_repetitions": [
          1,
          2,
          3,
          4,
          6,
          7,
          8,
          9
        ],
        "test_repetitions": [
          5,
          10
        ]
      }
    },
    "repetition_blocks": {
      "gestures": [
        "insert",
        "deinsert"
      ],
      "block_size": 5,
      "preserve_original_repetition_ids": true
    },
    "split_before_windowing": true
  }
